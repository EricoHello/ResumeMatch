{
  "name": "resumematch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-resumematch-tests \"vitest run --config tests/firestore/vitest.config.mts\"",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@google/genai": "2.19.0",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "mammoth": "1.12.2",
    "next": "16.3.3",
    "pdf-parse": "2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "20.1.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "docx": "9.7.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "firebase-tools": "15.28.2",
    "jsdom": "30.0.1",
    "pdf-lib": "1.17.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "re2@1.26.1": true,
    "unrs-resolver@1.12.2": true,
    "@firebase/util@1.15.3": true
  }
}
