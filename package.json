    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "docx": "9.7.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "pdf-lib": "1.17.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
