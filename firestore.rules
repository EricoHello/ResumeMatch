rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasExactJobPreferenceFields(data) {
      return data.keys().hasOnly([
        'schemaVersion',
        'targetLocation',
        'additionalLocations',
        'radiusMiles',
        'workArrangement',
        'minimumSalary',
        'salaryCurrency',
        'salaryPeriod',
        'createdAt',
        'updatedAt'
      ]) && data.keys().hasAll([
        'schemaVersion',
        'targetLocation',
        'additionalLocations',
        'radiusMiles',
        'workArrangement',
        'minimumSalary',
        'salaryCurrency',
        'salaryPeriod',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidJobPreferenceValues(data) {
      return data.schemaVersion is int
        && data.schemaVersion == 2
        && data.targetLocation is string
        && data.targetLocation.size() >= 1
        && data.targetLocation.size() <= 120
        && data.additionalLocations is list
        && data.additionalLocations.size() <= 3
        && (data.additionalLocations.size() < 1
          || (data.additionalLocations[0] is string
            && data.additionalLocations[0].size() >= 1
            && data.additionalLocations[0].size() <= 120
            && data.additionalLocations[0] != data.targetLocation))
        && (data.additionalLocations.size() < 2
          || (data.additionalLocations[1] is string
            && data.additionalLocations[1].size() >= 1
            && data.additionalLocations[1].size() <= 120
            && data.additionalLocations[1] != data.targetLocation
            && data.additionalLocations[1] != data.additionalLocations[0]))
        && (data.additionalLocations.size() < 3
          || (data.additionalLocations[2] is string
            && data.additionalLocations[2].size() >= 1
            && data.additionalLocations[2].size() <= 120
            && data.additionalLocations[2] != data.targetLocation
            && data.additionalLocations[2] != data.additionalLocations[0]
            && data.additionalLocations[2] != data.additionalLocations[1]))
        && data.radiusMiles is int
        && data.radiusMiles >= 5
        && data.radiusMiles <= 100
        && data.workArrangement is string
        && data.workArrangement in ['any', 'remote', 'hybrid', 'in_person']
        && data.minimumSalary is int
        && data.minimumSalary >= 0
        && data.minimumSalary <= 10000000
        && data.salaryCurrency is string
        && data.salaryCurrency == 'USD'
        && data.salaryPeriod is string
        && data.salaryPeriod == 'year'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt <= data.updatedAt;
    }

    function isValidJobPreference(data) {
      return hasExactJobPreferenceFields(data)
        && hasValidJobPreferenceValues(data);
    }

    match /users/{uid}/preferences/job {
      allow get: if ownsUserData(uid);

      allow create: if ownsUserData(uid)
        && isValidJobPreference(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if ownsUserData(uid)
        && isValidJobPreference(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedAt >= resource.data.updatedAt;

      allow list, delete: if false;
    }

    // Saved resumes are server-managed through authenticated API routes.
    // Browser clients never read or write resume text or profiles directly.
    match /users/{uid}/resumeProfiles/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
