rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Point aggregates and history are mutated only by trusted server code.
    // Owners may read them directly; all browser writes remain denied.
    match /users/{uid} {
      allow get: if ownsUserData(uid);
      allow list, create, update, delete: if false;
    }

    match /users/{uid}/pointHistory/{entryId} {
      allow get, list: if ownsUserData(uid);
      allow create, update, delete: if false;
    }

    function hasExactJobPreferenceFields(data) {
      return data.keys().hasOnly([
        'schemaVersion',
        'targetLocation',
        'additionalLocations',
        'radiusMiles',
        'workArrangements',
        'employmentTypes',
        'minimumSalary',
        'salaryCurrency',
        'salaryPeriod',
        'createdAt',
        'updatedAt'
      ]) && data.keys().hasAll([
        'schemaVersion',
        'targetLocation',
        'additionalLocations',
        'radiusMiles',
        'workArrangements',
        'employmentTypes',
        'minimumSalary',
        'salaryCurrency',
        'salaryPeriod',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidJobPreferenceValues(data) {
      return data.schemaVersion is int
        && data.schemaVersion == 4
        && data.targetLocation is string
        && data.targetLocation.size() >= 1
        && data.targetLocation.size() <= 120
        && data.additionalLocations is list
        && data.additionalLocations.size() <= 3
        && (data.additionalLocations.size() < 1
          || (data.additionalLocations[0] is string
            && data.additionalLocations[0].size() >= 1
            && data.additionalLocations[0].size() <= 120
            && data.additionalLocations[0] != data.targetLocation))
        && (data.additionalLocations.size() < 2
          || (data.additionalLocations[1] is string
            && data.additionalLocations[1].size() >= 1
            && data.additionalLocations[1].size() <= 120
            && data.additionalLocations[1] != data.targetLocation
            && data.additionalLocations[1] != data.additionalLocations[0]))
        && (data.additionalLocations.size() < 3
          || (data.additionalLocations[2] is string
            && data.additionalLocations[2].size() >= 1
            && data.additionalLocations[2].size() <= 120
            && data.additionalLocations[2] != data.targetLocation
            && data.additionalLocations[2] != data.additionalLocations[0]
            && data.additionalLocations[2] != data.additionalLocations[1]))
        && data.radiusMiles is int
        && data.radiusMiles >= 5
        && data.radiusMiles <= 100
        && data.workArrangements is list
        && data.workArrangements.size() <= 3
        && data.workArrangements.toSet().size() == data.workArrangements.size()
        && data.workArrangements.hasOnly(['remote', 'hybrid', 'in_person'])
        && data.employmentTypes is list
        && data.employmentTypes.size() <= 4
        && data.employmentTypes.toSet().size() == data.employmentTypes.size()
        && data.employmentTypes.hasOnly([
          'contract',
          'full_time',
          'part_time',
          'seasonal'
        ])
        && data.minimumSalary is int
        && data.minimumSalary >= 0
        && data.minimumSalary <= 10000000
        && data.salaryCurrency is string
        && data.salaryCurrency == 'USD'
        && data.salaryPeriod is string
        && data.salaryPeriod == 'year'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt <= data.updatedAt;
    }

    function isValidJobPreference(data) {
      return hasExactJobPreferenceFields(data)
        && hasValidJobPreferenceValues(data);
    }

    match /users/{uid}/preferences/job {
      allow get: if ownsUserData(uid);

      allow create: if ownsUserData(uid)
        && isValidJobPreference(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if ownsUserData(uid)
        && isValidJobPreference(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedAt >= resource.data.updatedAt;

      allow list, delete: if false;
    }

    // Saved resumes are server-managed through authenticated API routes.
    // Browser clients never read or write resume text or profiles directly.
    match /users/{uid}/resumeProfiles/{document=**} {
      allow read, write: if false;
    }

    // Applications are server-managed through authenticated API routes so URL
    // deduplication, validation, and timestamps cannot be bypassed by clients.
    match /users/{uid}/applications/{applicationId} {
      allow read, write: if false;
    }

    match /users/{uid}/settings/applications {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
