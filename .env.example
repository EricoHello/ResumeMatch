# Firebase Web SDK (safe to expose to the browser; required for Google Sign-In)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only)
# Railway: set this to the complete service-account JSON object.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional local-development alternative. Never set this in production.
# Example: /absolute/path/to/firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT_FILE=
