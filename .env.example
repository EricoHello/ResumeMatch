# Firebase Web SDK (safe to expose to the browser; required for Google Sign-In)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only)
# Railway: set this to the complete service-account JSON object as one value.
# In a dotenv file, single-quote multiline JSON so it is not truncated to "{".
FIREBASE_SERVICE_ACCOUNT_JSON=

# Recommended local-development alternative. Never set this in production.
# When set locally, this file takes precedence over the inline JSON value.
# Example: /absolute/path/to/firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT_FILE=

# Server-only AI and job-search credentials
GEMINI_API_KEY=

OPENWEBNINJA_API_KEY=

# Server-only account data export email delivery through Resend.
RESEND_API_KEY=
# Must be a sender address/domain verified in Resend.
# Example: ResumeMatch <data@example.com>
RESEND_FROM_EMAIL=

# Set to true to show the maintenance page and block parsing/provider requests.
MAINTENANCE_MODE=true

# Optional isolation switch: ignore resume relevance; use only location and salary.
JOB_SEARCH_SMOKE_TEST=false

# Optional: enable safe job-search pipeline diagnostics in production logs.
JOB_SEARCH_DEBUG=false
